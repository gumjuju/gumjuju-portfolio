# Supabase — get from: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Vercel Blob — get from: vercel.com → your project → Storage → Blob
BLOB_READ_WRITE_TOKEN=your-blob-read-write-token-here

# Formspree — get from: formspree.io → your form → Integration
FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id-here
